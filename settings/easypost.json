{
  "$schema": "https://json.swell.store/setting.json",
  "label": "EasyPost",
  "description": "Live EasyPost rates at checkout, shipping labels for your orders, and tracking back to Swell. Get an API key in EasyPost → Account Settings → API Keys.",
  "actions": [
    {
      "id": "test_connection",
      "label": "Test connection",
      "function": "test-connection",
      "loading_label": "Testing…",
      "hint": "Checks the API key and lists your EasyPost carrier accounts"
    },
    {
      "id": "refresh_tracking",
      "label": "Refresh tracking now",
      "function": "refresh-tracking-now",
      "loading_label": "Refreshing…",
      "hint": "Updates the tracking status of labels that haven't been delivered yet"
    }
  ],
  "fields": [
    {
      "id": "api_key",
      "label": "API key",
      "type": "secret",
      "required": true,
      "description": "EasyPost → Account Settings → API Keys. Use a test key (EZTK…) in your test environment and a production key (EZAK…) in live."
    },
    {
      "id": "enabled",
      "label": "Enabled",
      "type": "boolean",
      "ui": "toggle",
      "default": true,
      "description": "Turns off rates, labels, tracking and webhooks without uninstalling the app"
    },
    {
      "type": "field_group",
      "label": "Ship-from address",
      "description": "Where your parcels ship from. Used for rates and labels. Street, city, postal code and country are required.",
      "fields": [
        {
          "type": "field_row",
          "fields": [
            {
              "id": "from_name",
              "label": "Name",
              "type": "short_text",
              "admin_span": 2
            },
            {
              "id": "from_company",
              "label": "Company",
              "type": "short_text",
              "admin_span": 2
            }
          ]
        },
        {
          "id": "from_street1",
          "label": "Street",
          "type": "short_text",
          "required": true
        },
        {
          "id": "from_street2",
          "label": "Street line 2",
          "type": "short_text"
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "from_city",
              "label": "City",
              "type": "short_text",
              "required": true,
              "admin_span": 2
            },
            {
              "id": "from_state",
              "label": "State / province code",
              "type": "short_text",
              "admin_span": 2,
              "placeholder": "CA"
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "from_zip",
              "label": "Postal code",
              "type": "short_text",
              "required": true,
              "admin_span": 2
            },
            {
              "id": "from_country",
              "label": "Country code",
              "type": "short_text",
              "required": true,
              "admin_span": 2,
              "placeholder": "US",
              "description": "2-letter ISO code"
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "from_phone",
              "label": "Phone",
              "type": "short_text",
              "admin_span": 2
            },
            {
              "id": "from_email",
              "label": "Email",
              "type": "short_text",
              "admin_span": 2
            }
          ]
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Checkout rates",
      "description": "To show the rates, turn on EasyPost in Settings → Shipping and save.",
      "fields": [
        {
          "id": "rates_enabled",
          "label": "Show EasyPost rates at checkout",
          "type": "boolean",
          "ui": "toggle",
          "default": true
        },
        {
          "id": "carrier_accounts",
          "label": "Carrier accounts",
          "type": "short_text",
          "description": "Optional. Comma-separated EasyPost carrier account IDs (ca_…) to quote. Leave empty to quote all your carrier accounts."
        },
        {
          "id": "services",
          "label": "Services",
          "type": "short_text",
          "description": "Optional. Comma-separated carrier and service pairs to offer, e.g. USPS:Priority, UPS:Ground. Leave empty to offer every service."
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "markup_percent",
              "label": "Markup (%)",
              "type": "number",
              "default": 0,
              "min": 0,
              "admin_span": 2,
              "description": "Added to each rate"
            },
            {
              "id": "handling_fee",
              "label": "Handling fee",
              "type": "number",
              "default": 0,
              "min": 0,
              "admin_span": 2,
              "description": "Flat amount added to each rate, in the checkout currency"
            }
          ]
        },
        {
          "id": "show_delivery_days",
          "label": "Show estimated delivery days",
          "type": "boolean",
          "ui": "toggle",
          "default": true
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Default parcel",
      "description": "Every order is rated as one parcel with these dimensions. Weight is the sum of the items' shipping weights; the default weight is used when items have none.",
      "fields": [
        {
          "type": "field_row",
          "fields": [
            {
              "id": "parcel_length",
              "label": "Length",
              "type": "number",
              "default": 10,
              "min": 0,
              "admin_span": 1
            },
            {
              "id": "parcel_width",
              "label": "Width",
              "type": "number",
              "default": 8,
              "min": 0,
              "admin_span": 1
            },
            {
              "id": "parcel_height",
              "label": "Height",
              "type": "number",
              "default": 4,
              "min": 0,
              "admin_span": 1
            },
            {
              "id": "distance_unit",
              "label": "Unit",
              "type": "select",
              "default": "in",
              "admin_span": 1,
              "options": [
                {
                  "value": "in",
                  "label": "in"
                },
                {
                  "value": "cm",
                  "label": "cm"
                }
              ]
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "default_weight",
              "label": "Default weight",
              "type": "number",
              "default": 1,
              "min": 0,
              "admin_span": 2
            },
            {
              "id": "mass_unit",
              "label": "Weight unit",
              "type": "select",
              "default": "lb",
              "admin_span": 2,
              "options": [
                {
                  "value": "lb",
                  "label": "lb"
                },
                {
                  "value": "oz",
                  "label": "oz"
                },
                {
                  "value": "kg",
                  "label": "kg"
                },
                {
                  "value": "g",
                  "label": "g"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Labels",
      "description": "Labels are bought from your EasyPost account and charged to it.",
      "fields": [
        {
          "id": "buy_on",
          "label": "Buy labels",
          "type": "select",
          "default": "manual",
          "options": [
            {
              "value": "manual",
              "label": "Only with Buy label on the order page"
            },
            {
              "value": "paid",
              "label": "Automatically when an order is paid"
            },
            {
              "value": "submitted",
              "label": "Automatically when an order is submitted"
            }
          ]
        },
        {
          "id": "label_service",
          "label": "Label service",
          "type": "select",
          "default": "chosen_or_cheapest",
          "options": [
            {
              "value": "chosen_or_cheapest",
              "label": "Service the customer chose, else the cheapest"
            },
            {
              "value": "chosen",
              "label": "Only the service the customer chose"
            },
            {
              "value": "cheapest",
              "label": "Always the cheapest"
            }
          ],
          "description": "For orders shipped with a non-EasyPost service, the first and last options buy the cheapest rate; Only the service the customer chose buys no label"
        },
        {
          "id": "label_format",
          "label": "Label format",
          "type": "select",
          "default": "PDF",
          "options": [
            {
              "value": "PDF",
              "label": "PDF"
            },
            {
              "value": "PNG",
              "label": "PNG"
            },
            {
              "value": "ZPL",
              "label": "ZPL (thermal printers)"
            }
          ]
        },
        {
          "id": "create_fulfillment",
          "label": "Create Swell shipment when a label is bought",
          "type": "boolean",
          "ui": "toggle",
          "default": true,
          "description": "Fulfills the order in Swell with the carrier and tracking number. When off, the label and tracking are still saved on the EasyPost tab."
        },
        {
          "id": "customs_signer",
          "label": "Customs signer",
          "type": "short_text",
          "description": "Name that signs customs forms for international labels. Defaults to the ship-from name."
        }
      ]
    },
    {
      "type": "field_group",
      "label": "Webhook",
      "description": "Optional. Gives you tracking updates as they happen instead of every hour.",
      "fields": [
        {
          "id": "webhook_secret",
          "label": "Webhook secret",
          "type": "secret",
          "description": "Optional, recommended. When set, EasyPost must sign each event with the same secret (enter it as the webhook secret in EasyPost), and unsigned events are rejected. When empty, events are accepted unsigned."
        },
        {
          "id": "webhook_url",
          "label": "Webhook URL",
          "type": "short_text",
          "readonly": true,
          "default": "https://{store-id}:{public-key}@{store-id}.swell.store/functions/easypost/easypost-webhook",
          "description": "Replace {store-id} with your store ID and {public-key} with your Swell public key (Developer → API keys; test key for test, live key for live). Add it in EasyPost → Account Settings → Webhooks, in the same mode (test or production) as your API key, with the webhook secret above."
        }
      ]
    }
  ]
}
